Instance.new("UIStroke", notify).Color = Color3.fromRGB(120, 170, 255)

local function showNotify(text, color)
	notify.Text = text
	notify.BackgroundColor3 = color
	notify.Visible = true
	notify.TextTransparency = 1
	notify.BackgroundTransparency = 1

	TweenService:Create(notify, TweenInfo.new(0.25), {
		TextTransparency = 0,
		BackgroundTransparency = 0
	}):Play()

	task.delay(1.2, function()
		TweenService:Create(notify, TweenInfo.new(0.3), {
			TextTransparency = 1,
			BackgroundTransparency = 1
		}):Play()
		task.wait(0.3)
		notify.Visible = false
	end)
end

--------------------------------------------------
-- DRAG
--------------------------------------------------
local dragging, dragStart, startPos

local function updateDrag(input)
	local delta = input.Position - dragStart
	frame.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then
		updateDrag(input)
	end
end)

--------------------------------------------------
-- TOOL FUNCTIONS
--------------------------------------------------
local function clearTools()
	for _, tool in ipairs(equippedTools) do
		if tool and tool.Parent then
			tool.Parent = player.Backpack
		end
	end
	table.clear(equippedTools)
end

local function equipAllTools()
	if not character then return end

	for _, tool in ipairs(player.Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			tool.Parent = character
			table.insert(equippedTools, tool)
		end
	end
end

--------------------------------------------------
-- TOGGLE
--------------------------------------------------
toggle.MouseButton1Click:Connect(function()
	clickSound:Play()
	enabled = not enabled

	if enabled then
		toggle.Text = "✅ เปิด"
		toggle.BackgroundColor3 = Color3.fromRGB(70, 200, 120)
		equipAllTools()
		showNotify("เปิดการใช้งาน", Color3.fromRGB(60, 170, 100))
	else
		toggle.Text = "❌ ปิด"
		toggle.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
		clearTools()
		showNotify("ปิดการใช้งาน", Color3.fromRGB(160, 60, 60))
	end
end)

--------------------------------------------------
-- CHARACTER RESPAWN FIX (สำคัญ)
--------------------------------------------------
local function onCharacterAdded(char)
	character = char
	clearTools()

	task.wait(0.3) -- รอ Backpack พร้อม

	if enabled then
		equipAllTools()
	end
end

player.CharacterAdded:Connect(onCharacterAdded)

-- เผื่อเข้าเกมมาแล้วมีตัวละครอยู่
if player.Character then
	onCharacterAdded(player.Character)
end
