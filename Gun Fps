local ESPBoxes = {}

--------------------------------------------------
-- CREATE ESP
--------------------------------------------------

local function CreateESP(player)

    if player == LP then
        return
    end

    local lines = {}

    for i = 1,12 do

        local line = Drawing.new("Line")

        line.Visible = false
        line.Thickness = 1.5
        line.Color = White

        table.insert(lines,line)
    end

    ESPBoxes[player] = lines
end

--------------------------------------------------
-- REMOVE ESP
--------------------------------------------------

local function RemoveESP(player)

    if ESPBoxes[player] then

        for _,line in pairs(ESPBoxes[player]) do
            line:Remove()
        end

        ESPBoxes[player] = nil
    end
end

--------------------------------------------------
-- PLAYER EVENTS
--------------------------------------------------

for _,p in pairs(PL:GetPlayers()) do
    CreateESP(p)
end

PL.PlayerAdded:Connect(CreateESP)
PL.PlayerRemoving:Connect(RemoveESP)

--------------------------------------------------
-- DRAW BOX
--------------------------------------------------

local function DrawBox(player,color)

    local lines = ESPBoxes[player]

    if not lines then
        return
    end

    local char = player.Character

    if not char then

        for _,l in pairs(lines) do
            l.Visible = false
        end

        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")

    if not hrp then

        for _,l in pairs(lines) do
            l.Visible = false
        end

        return
    end

    local cf = hrp.CFrame
    local size = Vector3.new(4,6,2)

    local corners = {

        cf * Vector3.new(-size.X/2, size.Y/2, -size.Z/2),
        cf * Vector3.new(size.X/2, size.Y/2, -size.Z/2),
        cf * Vector3.new(size.X/2, -size.Y/2, -size.Z/2),
        cf * Vector3.new(-size.X/2, -size.Y/2, -size.Z/2),

        cf * Vector3.new(-size.X/2, size.Y/2, size.Z/2),
        cf * Vector3.new(size.X/2, size.Y/2, size.Z/2),
        cf * Vector3.new(size.X/2, -size.Y/2, size.Z/2),
        cf * Vector3.new(-size.X/2, -size.Y/2, size.Z/2)
    }

    local points = {}

    for i,v in pairs(corners) do

        local p,visible =
            CM:WorldToViewportPoint(v)

        points[i] = {
            Vector2.new(p.X,p.Y),
            visible
        }
    end

    local connections = {

        {1,2},{2,3},{3,4},{4,1},
        {5,6},{6,7},{7,8},{8,5},
        {1,5},{2,6},{3,7},{4,8}
    }

    for i,conn in pairs(connections) do

        local a = points[conn[1]]
        local b = points[conn[2]]

        if a[2]
        and b[2]
        and ESPEnabled then

            lines[i].Visible = true
            lines[i].From = a[1]
            lines[i].To = b[1]
            lines[i].Color = color

        else

            lines[i].Visible = false
        end
    end
end

--------------------------------------------------
-- SILENT AIM
--------------------------------------------------

local _ON

_ON = hookmetamethod(game,"__namecall",newcclosure(function(s,...)

    local m = getnamecallmethod()
    local a = {...}

    if not checkcaller()
    and SilentAimEnabled
    and CurrentTargetPart then

        if m == "FireServer"
        and tostring(s) == "CommunicateGun" then

            a[2] = CurrentTargetPart.Position
        end

        if m == "FindPartOnRayWithIgnoreList"
        or m == "FindPartOnRayWithWhitelist"
        or m == "FindPartOnRay" then

            local o = a[1].Origin

            a[1] = Ray.new(
                o,
                (CurrentTargetPart.Position - o).Unit * 1000
            )

            return _ON(s, unpack(a))

        elseif m == "Raycast" then

            a[2] =
                (CurrentTargetPart.Position - a[1]).Unit * 1000

            return _ON(s, unpack(a))
        end
    end

    return _ON(s,...)
end))

--------------------------------------------------
-- MOUSE INDEX
--------------------------------------------------

local _OI

_OI = hookmetamethod(game,"__index",newcclosure(function(s,i)

    if not checkcaller()
    and s == MS
    and SilentAimEnabled
    and CurrentTargetPart then

        if i == "Hit"
        or i == "hit" then

            return CurrentTargetPart.CFrame

        elseif i == "Target"
        or i == "target" then

            return CurrentTargetPart
        end
    end

    return _OI(s,i)
end))

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

RS:BindToRenderStep("SilentAimUpdate",201,function()

    local center = Vector2.new(
        CM.ViewportSize.X / 2,
        CM.ViewportSize.Y / 2
    )

    --------------------------------------------------
    -- FOV
    --------------------------------------------------

    FOVCircle.Visible = showFov
    FOVCircle.Position = center
    FOVCircle.Color = FOVColor

    --------------------------------------------------
    -- FIND TARGET
    --------------------------------------------------

    local target = nil
    local closest = FOVCircle.Radius

    for _,p in pairs(PL:GetPlayers()) do

        if p ~= LP
        and p.Character
        and p.Character:FindFirstChild("Head") then

            local head = p.Character.Head

            local pos,visible =
                CM:WorldToViewportPoint(head.Position)

            if visible then

                local dist =
                    (Vector2.new(pos.X,pos.Y) - center).Magnitude

                if dist < closest then
                    closest = dist
                    target = head
                end
            end
        end
    end

    CurrentTargetPart = target

    --------------------------------------------------
    -- AIM COLOR
    --------------------------------------------------

    local AimColor = Blue

    if target then

        local ray = CM:ViewportPointToRay(
            center.X,
            center.Y
        )

        local params = RaycastParams.new()

        params.FilterDescendantsInstances = {LP.Character}
        params.FilterType = Enum.RaycastFilterType.Blacklist

        local result = workspace:Raycast(
            ray.Origin,
            ray.Direction * 9999,
            params
        )

        if result
        and result.Instance
        and result.Instance:IsDescendantOf(target.Parent) then

            AimColor = Cyan
        end
    end

    --------------------------------------------------
    -- TRACER + HEAD CIRCLE
    --------------------------------------------------

    if target and SilentAimEnabled then

        local pos =
            CM:WorldToViewportPoint(target.Position)

        TracerOutline.Visible = true
        TracerOutline.From = center
        TracerOutline.To = Vector2.new(pos.X,pos.Y)

        TracerLine.Visible = true
        TracerLine.From = center
        TracerLine.To = Vector2.new(pos.X,pos.Y)
        TracerLine.Color = AimColor

        HeadOutline.Visible = true
        HeadOutline.Position = Vector2.new(pos.X,pos.Y)

        HeadCircle.Visible = true
        HeadCircle.Position = Vector2.new(pos.X,pos.Y)
        HeadCircle.Color = AimColor

    else

        TracerOutline.Visible = false
        TracerLine.Visible = false

        HeadOutline.Visible = false
        HeadCircle.Visible = false
    end

    --------------------------------------------------
    -- ESP UPDATE
    --------------------------------------------------

    for _,p in pairs(PL:GetPlayers()) do

        if p ~= LP then

            local color = White

            if target
            and p.Character
            and target:IsDescendantOf(p.Character) then

                color = AimColor
            end

            DrawBox(p,color)
        end
    end
end)

