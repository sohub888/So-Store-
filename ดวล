local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Backpack = LocalPlayer:WaitForChild("Backpack")

-- VARIABLES
local HighlightEnabled = false
local HighlightObject = nil
local CurrentTool = nil
local RainbowThread = 0

local RainbowColors = {
	Color3.fromRGB(255, 0, 0),
	Color3.fromRGB(255, 127, 0),
	Color3.fromRGB(255, 255, 0),
	Color3.fromRGB(0, 255, 0),
	Color3.fromRGB(0, 255, 255),
	Color3.fromRGB(0, 0, 255),
	Color3.fromRGB(148, 0, 211)
}

--------------------------------------------------
-- FUNCTIONS
--------------------------------------------------

local function RemoveHighlight()
	if HighlightObject then
		HighlightObject:Destroy()
		HighlightObject = nil
	end
end

local function CreateHighlight(Tool)
	if not Tool then
		return
	end

	RemoveHighlight()

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "RGBHighlight"
	Highlight.Adornee = Tool
	Highlight.FillTransparency = 0.2
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Parent = Tool

	HighlightObject = Highlight
end

local function GetCurrentTool()
	local Character = LocalPlayer.Character

	if Character then
		local Tool = Character:FindFirstChildOfClass("Tool")
		if Tool then
			return Tool
		end
	end

	return Backpack:FindFirstChildOfClass("Tool")
end

local function StartRainbow()
	RainbowThread += 1
	local ThreadId = RainbowThread

	task.spawn(function()
		local Index = 1

		while HighlightEnabled and ThreadId == RainbowThread do
			if HighlightObject and HighlightObject.Parent then
				local Color = RainbowColors[Index]

				local Tween = TweenService:Create(
					HighlightObject,
					TweenInfo.new(0.15, Enum.EasingStyle.Linear),
					{
						FillColor = Color,
						OutlineColor = Color
					}
				)

				Tween:Play()

				Index += 1
				if Index > #RainbowColors then
					Index = 1
				end
			end

			task.wait(0.15)
		end
	end)
end

local function UpdateTool()
	if not HighlightEnabled then
		return
	end

	local Tool = GetCurrentTool()

	if Tool ~= CurrentTool then
		CurrentTool = Tool

		if Tool then
			CreateHighlight(Tool)
		else
			RemoveHighlight()
		end
	end
end

--------------------------------------------------
-- TOOL DETECTION
--------------------------------------------------

local function SetupCharacter(Character)
	Character.ChildAdded:Connect(function(Child)
		if Child:IsA("Tool") then
			task.wait()
			UpdateTool()
		end
	end)

	Character.ChildRemoved:Connect(function(Child)
		if Child:IsA("Tool") then
			task.wait()
			UpdateTool()
		end
	end)
end

if LocalPlayer.Character then
	SetupCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(SetupCharacter)

Backpack.ChildAdded:Connect(function()
	task.wait()
	UpdateTool()
end)

Backpack.ChildRemoved:Connect(function()
	task.wait()
	UpdateTool()
end)

