local Toggle = Tab:Toggle({
	Title = "RGB Tool Highlight",
	Desc = "",
	Icon = "power",
	Value = false,
	Type = "Toggle",
	Locked = false,
	Flag = "RGBToolHighlight",

	Callback = function(State)
		HighlightEnabled = State

		if State then
			CurrentTool = GetCurrentTool()

			if CurrentTool then
				CreateHighlight(CurrentTool)
				StartRainbow()
			end
		else
			RainbowThread += 1
			CurrentTool = nil
			RemoveHighlight()
		end
	end
})

